# Root Docker Compose environment.
# Copy to .env only when you want to override docker-compose.yml defaults.

FIREBASE_PROJECT_ID=demo-snag
FIRESTORE_EMULATOR_HOST=firestore:8085

HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX_PER_MINUTE=100
WAIT_TIMEOUT_MS=30000

REDIS_URL=redis://redis:6379
DELIVERY_QUEUE_NAME=delivery-forwarding
ENABLE_DELIVERY_WORKER=true

MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_HOURS=720

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
