{
  "name": "snag-cli",
  "private": false,
  "version": "0.0.4",
  "description": "Open-source webhook inspector CLI for Snag: create public capture URLs, stream live requests, forward them to localhost, inspect payloads, and replay webhooks.",
  "type": "module",
  "homepage": "https://snag-web-five.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munimx/Snag.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/munimx/Snag/issues"
  },
  "keywords": [
    "webhook",
    "webhooks",
    "inspector",
    "tunnel",
    "cli",
    "developer-tools",
    "mcp",
    "snag"
  ],
  "bin": {
    "snag": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist', { recursive: true, force: true }))\" && tsc -p tsconfig.build.json",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "ink": "^6.3.1",
    "react": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@snag/shared": "workspace:*",
    "@types/react": "^19.2.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  }
}
