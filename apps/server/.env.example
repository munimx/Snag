# Local server environment for pnpm-based development.
# For zero-cost local storage, run the Firestore emulator:
#   firebase emulators:start --only firestore

FIREBASE_PROJECT_ID=demo-snag
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX_PER_MINUTE=100
WAIT_TIMEOUT_MS=30000

REDIS_URL=redis://127.0.0.1:6379
DELIVERY_QUEUE_NAME=delivery-forwarding

# Keep false for a no-Redis local inspector. Set true when testing forwarding rules.
ENABLE_DELIVERY_WORKER=false

MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_HOURS=720
